# ============================================================
# Startup Starter — STAGING environment template
# Copy to .env.staging and fill with real values. NEVER commit secrets.
#   cp .env.staging.example .env.staging
#   docker compose -f docker-compose.prod.yml --env-file .env.staging up -d --build
# ============================================================

# --- Domain / TLS ---
# Public staging domain (A record -> VPS IP). Caddy provisions Let's Encrypt.
STAGING_DOMAIN=app-staging.example.com
# Local simulation without a domain: app-staging.local + deploy/Caddyfile (internal CA).
# CADDY_CONFIG=./deploy/Caddyfile
# Production/public domain: CADDY_CONFIG=./deploy/Caddyfile.prod (automatic TLS)

# --- Frontend URLs (baked into the Next.js build) ---
NEXT_PUBLIC_API_URL=https://app-staging.example.com/api/v1
NEXT_PUBLIC_WS_URL=https://app-staging.example.com
NEXT_PUBLIC_FRONTEND_URL=https://app-staging.example.com
# Backend uses FRONTEND_URL for links inside emails.
FRONTEND_URL=https://app-staging.example.com
# Exact origins allowed to call the API (browser origin + API origin).
CORS_ORIGINS=https://app-staging.example.com

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<generate: openssl rand -hex 24>
POSTGRES_DB=startup_starter

# --- Secrets (generate with `openssl rand -hex 64`) ---
JWT_ACCESS_SECRET=<generate: openssl rand -hex 64>
JWT_REFRESH_SECRET=<generate: openssl rand -hex 64>
STORAGE_SIGNING_SECRET=<generate: openssl rand -hex 64>
AI_API_KEY=<generate: openssl rand -hex 32>
DEV_WEBHOOK_SECRET=<generate: openssl rand -hex 32>   # dev payment provider only

# --- Cookies (HTTPS staging: keep true) ---
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# --- Storage (S3-compatible, e.g. AWS S3 / Scaleway / OVH / MinIO on the VPS) ---
STORAGE_PROVIDER=s3
S3_ENDPOINT=<your s3 endpoint>
S3_REGION=<your region>
S3_BUCKET=<your bucket>
S3_ACCESS_KEY=<your access key>
S3_SECRET_KEY=<your secret key>
S3_FORCE_PATH_STYLE=true

# --- Email (real SMTP provider, e.g. Brevo / Mailgun / SES / Postmark) ---
EMAIL_PROVIDER=smtp
EMAIL_FROM=Startup Starter <no-reply@yourdomain.com>
SMTP_HOST=<smtp provider host>
SMTP_PORT=587
# Port 587 uses STARTTLS; use true only with implicit TLS on port 465.
SMTP_SECURE=false
SMTP_USER=<smtp user>
SMTP_PASS=<smtp password>

# --- AI (OpenAI-compatible provider) ---
AI_PROVIDER=openai
OPENAI_API_KEY=<your openai key>
OPENAI_MODEL=gpt-4o-mini
# Shared secret the backend sends to the AI service (both must match).

# --- Job source aggregation (optional official Jooble API access) ---
# Without a key, only verified EasyJob employer listings are displayed.
# JOOBLE_API_KEY=<jooble-api-key>
JOOBLE_API_BASE_URL=https://tn.jooble.org/api/

# --- Payments — STRIPE TEST MODE ONLY ---
PAYMENT_PROVIDER=stripe
# Set true only after a Konnect account, wallet and webhook are configured.
KONNECT_ENABLED=false
KONNECT_MODE=sandbox
KONNECT_API_BASE_URL=
KONNECT_API_KEY=
KONNECT_RECEIVER_WALLET_ID=
KONNECT_WEBHOOK_URL=
KONNECT_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MAP_CANDIDATE_PRO_MONTHLY=price_...
STRIPE_PRICE_MAP_CANDIDATE_PRO_YEARLY=price_...
STRIPE_PRICE_MAP_COMPANY_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_MAP_COMPANY_BUSINESS_YEARLY=price_...
STRIPE_PRICE_MAP_COMPANY_PRO_MONTHLY=price_...
STRIPE_PRICE_MAP_COMPANY_PRO_YEARLY=price_...
STRIPE_PRICE_MAP_COMPANY_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_MAP_COMPANY_ENTERPRISE_YEARLY=price_...

# --- Biometric face login (OPTIONAL — OFF until validated) ---
BIOMETRIC_ENABLED=false
BIOMETRIC_ENCRYPTION_KEY=
FACE_MATCH_THRESHOLD=0.5
FACE_LIVENESS_ENABLED=true
FACE_MAX_ATTEMPTS=5
FACE_ATTEMPT_WINDOW_MS=600000
FACE_BLOCK_MS=600000
FACE_CHALLENGE_TTL_SECONDS=120
FACE_MAX_IMAGE_BYTES=5242880
AI_FACE_SERVICE_URL=http://ai:8000
# Server-side company directory provider (optional; GLEIF/local fallback remains available).
# OPENCORPORATES_API_TOKEN=
# Optional public research layer (disabled until Agent Reach is installed and reviewed)
EXTERNAL_RESEARCH_ENABLED=false
AGENT_REACH_ENABLED=false
AGENT_REACH_COMMAND=agent-reach
# Optional REA enrichment runs only in the protected research worker.
REA_ENABLED=false
REA_COMMAND=rea
# REA_ARGS=--some-arg
# REA_BROWSER_EXECUTABLE=/absolute/path/to/chrome
# REA_TIMEOUT_MS=30000

# --- EasyJob Skills ---
EASYJOB_SKILLS_ENABLED=true
INTERVIEW_TRANSCRIPTION_ENABLED=false
INTERVIEW_VAD_ENABLED=true
SILERO_VAD_MIN_SILENCE_MS=450
INTERVIEW_LIVE_ASSISTANT_ENABLED=true
INTERVIEW_TRANSCRIPT_RETENTION_DAYS=90
INTERVIEW_FOLLOWUP_ENABLED=true
INTERVIEW_SKILL_COVERAGE_ENABLED=true
EXTERNAL_RESEARCH_ALLOWED_SOURCES=web,github,rss
