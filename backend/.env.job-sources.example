# Optional licensed feeds. Leave disabled until the source grants ingestion and redistribution rights.
# Official employer career pages / public ATS postings in Tunisia (daily, no API key).
# EY, Sofrecom, Devoteam, Sopra Steria, LEONI, Accor, Lesaffre, Bosch.
# All publicly listed Tunisia roles, not restricted to software or Tunis city.
JOB_SOURCE_COMPANY_DIRECT_ENABLED=false
JOB_SOURCE_COMPANY_DIRECT_MAX_PAGES=10

# Other full-snapshot feeds only: employer-scoped confirmed removals occur each run.
JOB_SOURCE_MISSING_GRACE_HOURS=72
CAREERJET_PUBLISHER_AUTHORIZED=false
CAREERJET_API_KEY=
JOB_SOURCE_ANETI_AUTHORIZED=false
JOB_SOURCE_ANETI_INTERNATIONAL_AUTHORIZED=false

# APEC: licensed EasyJob interchange gateway, not a guessed vendor endpoint.
JOB_SOURCE_APEC_ENABLED=false
JOB_SOURCE_APEC_AUTHORIZED=false
JOB_SOURCE_APEC_FORMAT=easyjob-v1
JOB_SOURCE_APEC_FEED_URL=
JOB_SOURCE_APEC_TOKEN=
JOB_SOURCE_APEC_MAX_PAGES=100
JOB_SOURCE_APEC_REQUEST_INTERVAL_MS=1000

# GLASSDOOR: licensed EasyJob interchange gateway, not a guessed vendor endpoint.
JOB_SOURCE_GLASSDOOR_ENABLED=false
JOB_SOURCE_GLASSDOOR_AUTHORIZED=false
JOB_SOURCE_GLASSDOOR_FORMAT=easyjob-v1
JOB_SOURCE_GLASSDOOR_FEED_URL=
JOB_SOURCE_GLASSDOOR_TOKEN=
JOB_SOURCE_GLASSDOOR_MAX_PAGES=100
JOB_SOURCE_GLASSDOOR_REQUEST_INTERVAL_MS=1000

# WELCOME_TO_THE_JUNGLE: licensed EasyJob interchange gateway, not a guessed vendor endpoint.
JOB_SOURCE_WELCOME_TO_THE_JUNGLE_ENABLED=false
JOB_SOURCE_WELCOME_TO_THE_JUNGLE_AUTHORIZED=false
JOB_SOURCE_WELCOME_TO_THE_JUNGLE_FORMAT=easyjob-v1
JOB_SOURCE_WELCOME_TO_THE_JUNGLE_FEED_URL=
JOB_SOURCE_WELCOME_TO_THE_JUNGLE_TOKEN=
JOB_SOURCE_WELCOME_TO_THE_JUNGLE_MAX_PAGES=100
JOB_SOURCE_WELCOME_TO_THE_JUNGLE_REQUEST_INTERVAL_MS=1000

# External feeds are disabled in the platform-only product mode.
# TANITJOBS: public search pages are available only when explicitly enabled.
JOB_CATALOG_MODE=PLATFORM_ONLY
# A licensed interchange feed remains optional when FEED_URL is explicitly provided.
JOB_SOURCE_TANITJOBS_ENABLED=false
JOB_SOURCE_TANITJOBS_AUTHORIZED=false
JOB_SOURCE_TANITJOBS_FORMAT=easyjob-v1
JOB_SOURCE_TANITJOBS_FEED_URL=
JOB_SOURCE_TANITJOBS_TOKEN=
JOB_SOURCE_TANITJOBS_MAX_PAGES=250
JOB_SOURCE_TANITJOBS_REQUEST_INTERVAL_MS=1000

# INDEED: licensed EasyJob interchange gateway, not a guessed vendor endpoint.
JOB_SOURCE_INDEED_ENABLED=false
JOB_SOURCE_INDEED_AUTHORIZED=false
JOB_SOURCE_INDEED_FORMAT=easyjob-v1
JOB_SOURCE_INDEED_FEED_URL=
JOB_SOURCE_INDEED_TOKEN=
