# FreeHire: run your OWN collector with node scripts/freehire.cjs setup/start.
# Do not point this at freehire.me: its public API does not grant commercial reuse.
JOB_SOURCE_FREEHIRE_ENABLED=false
JOB_SOURCE_FREEHIRE_SELF_HOSTED=true
JOB_SOURCE_FREEHIRE_API_URL=http://127.0.0.1:8085/api/v1
JOB_SOURCE_FREEHIRE_MAX_PAGES=10
JOB_SOURCE_FREEHIRE_RECHECK_LIMIT=100

# JobOps OJCP sidecar
JOB_SOURCE_JOBOPS_ENABLED=false
JOB_SOURCE_JOBOPS_URL=http://jobops:3001
JOB_SOURCE_JOBOPS_QUERY=software engineer
# JOB_SOURCE_JOBOPS_SEARCH_TERMS=software engineer,frontend developer,data analyst
JOB_SOURCE_JOBOPS_MAX_PAGES=3
JOB_SOURCE_JOBOPS_PAGE_SIZE=50
JOB_SOURCE_JOBOPS_TIMEOUT_MS=15000

# KEEJOB: licensed EasyJob interchange gateway, not a guessed vendor endpoint.
JOB_SOURCE_KEEJOB_ENABLED=false
JOB_SOURCE_KEEJOB_AUTHORIZED=false
JOB_SOURCE_KEEJOB_FORMAT=easyjob-v1
JOB_SOURCE_KEEJOB_FEED_URL=
