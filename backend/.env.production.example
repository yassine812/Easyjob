# Copy to .env.production. Replace every placeholder before deployment.
NODE_ENV=production
STAGING_DOMAIN=jobs.example.com
PARLOR_DOMAIN=parlor.example.com
PARLOR_CONTEXT_SIZE=8192
COMPOSE_PROFILES=jobops,mirofish
CADDY_CONFIG=./deploy/Caddyfile.prod
FRONTEND_URL=https://jobs.example.com
CORS_ORIGINS=https://jobs.example.com
NEXT_PUBLIC_API_URL=https://jobs.example.com/api/v1
NEXT_PUBLIC_WS_URL=https://jobs.example.com
NEXT_PUBLIC_FRONTEND_URL=https://jobs.example.com
NEXT_PUBLIC_PARLOR_URL=https://parlor.example.com
POSTGRES_USER=postgres
POSTGRES_DB=easyjob
# Use a random hex password to avoid URI-escaping issues.
POSTGRES_PASSWORD=<random-32-byte-hex>
JWT_ACCESS_SECRET=<independent-random-64-byte-hex>
JWT_REFRESH_SECRET=<independent-random-64-byte-hex>
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
THROTTLE_ENABLED=true
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=storage
STORAGE_SIGNING_SECRET=<independent-random-32-byte-hex>
# Compose persists local files in storage_data. Back up this volume with PostgreSQL.
# For S3, set STORAGE_PROVIDER=s3 and configure S3_ENDPOINT/REGION/BUCKET/ACCESS_KEY/SECRET_KEY.
EMAIL_PROVIDER=smtp
EMAIL_FROM=EasyJob <access@yourdomain.com>
SUPPORT_EMAIL=
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
AI_SERVICE_URL=http://ai:8000
MIROFISH_ENABLED=true
MIROFISH_URL=http://mirofish:5001
MIROFISH_TIMEOUT_MS=30000
# A prepared MiroFish simulation and recruiter agent are required for the
# external swarm response. EasyJob keeps a local deterministic fallback when
# these are empty or the sidecar is unavailable.
MIROFISH_SIMULATION_ID=
MIROFISH_AGENT_ID=0
EXTERNAL_RESEARCH_ENABLED=false
AGENT_REACH_ENABLED=false
AGENT_REACH_COMMAND=agent-reach
# Optional REA enrichment runs only in the protected research worker.
REA_ENABLED=false
REA_COMMAND=rea
# REA_ARGS=--some-arg
# REA_BROWSER_EXECUTABLE=/absolute/path/to/chrome
# REA_TIMEOUT_MS=30000

# --- EasyJob Skills ---
EASYJOB_SKILLS_ENABLED=true
INTERVIEW_TRANSCRIPTION_ENABLED=false
INTERVIEW_VAD_ENABLED=true
SILERO_VAD_MIN_SILENCE_MS=450
INTERVIEW_LIVE_ASSISTANT_ENABLED=true
INTERVIEW_TRANSCRIPT_RETENTION_DAYS=90
INTERVIEW_FOLLOWUP_ENABLED=true
INTERVIEW_SKILL_COVERAGE_ENABLED=true
EXTERNAL_RESEARCH_ALLOWED_SOURCES=web,github,rss
AI_API_KEY=<independent-random-32-byte-hex>
AI_PROVIDER=openai
OPENAI_API_KEY=<provider-api-key>
OPENAI_MODEL=<model-available-on-your-provider>
# Optional OpenAI-compatible endpoint; leave empty to use provider default.
OPENAI_BASE_URL=
# Optional Jooble connector. Public employer pages and Tanitjobs need no key.
# JOOBLE_API_KEY=<jooble-api-key>
# Official Tunisia employer jobs: daily collection in the production worker, no key.
JOB_CATALOG_MODE=PLATFORM_ONLY
JOB_SOURCE_COMPANY_DIRECT_ENABLED=false
JOB_SOURCE_COMPANY_DIRECT_MAX_PAGES=10
JOB_SOURCE_TANITJOBS_ENABLED=false
JOB_SOURCE_TANITJOBS_MAX_PAGES=250
JOB_SOURCE_TANITJOBS_REQUEST_INTERVAL_MS=1000
JOOBLE_API_BASE_URL=https://tn.jooble.org/api/

# Integrated JobOps sidecar. The profile and feature flag are enabled by default.
JOB_SOURCE_JOBOPS_ENABLED=false
JOB_SOURCE_JOBOPS_URL=http://jobops:3001
JOB_SOURCE_JOBOPS_QUERY=software engineer
JOB_SOURCE_JOBOPS_SEARCH_TERMS=software engineer,frontend developer,data analyst
JOB_SOURCE_JOBOPS_MAX_PAGES=3
JOB_SOURCE_JOBOPS_PAGE_SIZE=50
JOB_SOURCE_JOBOPS_TIMEOUT_MS=15000
# Enable only after camera testing and threshold calibration on staging.
BIOMETRIC_ENABLED=false
BIOMETRIC_ENCRYPTION_KEY=<independent-random-32-byte-hex>
FACE_LIVENESS_ENABLED=true
FACE_MATCH_THRESHOLD=0.5
AI_FACE_SERVICE_URL=http://ai:8000
# Choose a real payment adapter; configure its live credentials and webhook.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=<stripe-live-secret>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>
STRIPE_PRICE_MAP_CANDIDATE_PRO_MONTHLY=<price-id>
STRIPE_PRICE_MAP_CANDIDATE_PRO_YEARLY=<price-id>
STRIPE_PRICE_MAP_CANDIDATE_PREMIUM_MONTHLY=<price-id>
STRIPE_PRICE_MAP_CANDIDATE_PREMIUM_YEARLY=<price-id>
STRIPE_PRICE_MAP_COMPANY_BUSINESS_MONTHLY=<price-id>
STRIPE_PRICE_MAP_COMPANY_BUSINESS_YEARLY=<price-id>
STRIPE_PRICE_MAP_COMPANY_PRO_MONTHLY=<price-id>
STRIPE_PRICE_MAP_COMPANY_PRO_YEARLY=<price-id>
STRIPE_PRICE_MAP_COMPANY_ENTERPRISE_MONTHLY=<price-id>
STRIPE_PRICE_MAP_COMPANY_ENTERPRISE_YEARLY=<price-id>
# Alternative PAYMENT_PROVIDER=konnect:
KONNECT_ENABLED=false
KONNECT_MODE=live
# Optional override; otherwise mode selects the documented Konnect endpoint.
KONNECT_API_BASE_URL=
KONNECT_API_KEY=
KONNECT_RECEIVER_WALLET_ID=
# https://YOUR_PUBLIC_DOMAIN/api/v1/payments/webhook/konnect (no query string)
KONNECT_WEBHOOK_URL=
# Optional compatibility header for custom POST callbacks. Standard Konnect GET
# callbacks are verified by retrieving payment details with KONNECT_API_KEY.
KONNECT_WEBHOOK_SECRET=
# Server-side FX quote endpoint returning { rates: { EUR: ..., USD: ... } } for ?base=TND&symbols=...
FX_RATES_URL=
# Server-side company directory provider (optional; GLEIF/local fallback remains available).
# OPENCORPORATES_API_TOKEN=
