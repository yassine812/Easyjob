{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": "test/e2e/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
  },
  "testEnvironment": "node",
  "testTimeout": 120000,
  "maxWorkers": 1,
  "forceExit": true,
  "globalSetup": "./test/global-setup.ts",
  "setupFilesAfterEnv": ["./test/setup.ts"]
}
