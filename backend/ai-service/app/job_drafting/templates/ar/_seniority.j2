{% macro expectations() -%}{% if seniority == 'JUNIOR' %}ستساهم بتوجيه من الفريق وتطوّر ممارسات الاختبار والتوثيق والتحقق، مع اكتساب الاستقلالية عبر مهام محددة وملاحظات دورية.{% elif seniority == 'MID' %}ستتولى المهام من التصميم إلى التسليم وتساهم في قرارات الفريق مع الحفاظ على جودة المخرجات ووضوح توثيقها.{% elif seniority == 'SENIOR' %}ستتولى القرارات {% if technical %}المعمارية{% else %}المهنية{% endif %} ومعايير الجودة وتوضح المخاطر وطرق التحقق من النتائج. كما ستوجّه الزملاء الأقل خبرة وتشارك الممارسات المجربة.{% else %}ستحدد التوجهات المشتركة وتنسق الأولويات والاعتماديات بين الفرق وتدعم اعتماد معايير موحدة وتطوير مهارات الفريق.{% endif %}{%- endmacro %}
