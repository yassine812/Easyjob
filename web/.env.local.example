# Frontend environment (development). Never put backend secrets here —
# these are public URLs the browser needs.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3001
# Optional free local Parlor sidecar (https://github.com/fikrikarim/parlor)
NEXT_PUBLIC_PARLOR_URL=http://localhost:8001

# Production example (single-domain):
# NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN.com/api/v1
# NEXT_PUBLIC_WS_URL=https://YOUR_DOMAIN.com
# NEXT_PUBLIC_FRONTEND_URL=https://YOUR_DOMAIN.com
