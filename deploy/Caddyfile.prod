# Production Caddyfile — automatic Let's Encrypt TLS.
# Requires STAGING_DOMAIN to be a public domain with an A/AAAA record pointing
# at this server, and ports 80/443 reachable for the ACME challenge.

{$STAGING_DOMAIN} {
	encode gzip

	# Socket.IO — must be proxied with WebSocket upgrade enabled.
	handle /socket.io/* {
		reverse_proxy api:3000
	}

	# NestJS REST API + Swagger.
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /docs* {
		reverse_proxy api:3000
	}
	handle /health {
		reverse_proxy api:3000
	}

	# Next.js frontend.
	handle {
		reverse_proxy web:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
