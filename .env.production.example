# Copy to .env.production. Replace every placeholder before deployment.
NODE_ENV=production
STAGING_DOMAIN=jobs.example.com
CADDY_CONFIG=./deploy/Caddyfile.prod
FRONTEND_URL=https://jobs.example.com
CORS_ORIGINS=https://jobs.example.com
NEXT_PUBLIC_API_URL=https://jobs.example.com/api/v1
NEXT_PUBLIC_WS_URL=https://jobs.example.com
NEXT_PUBLIC_FRONTEND_URL=https://jobs.example.com
POSTGRES_USER=postgres
POSTGRES_DB=easyjob
# Use a random hex password to avoid URI-escaping issues.
POSTGRES_PASSWORD=<random-32-byte-hex>
JWT_ACCESS_SECRET=<independent-random-64-byte-hex>
JWT_REFRESH_SECRET=<independent-random-64-byte-hex>
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
THROTTLE_ENABLED=true
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=storage
STORAGE_SIGNING_SECRET=<independent-random-32-byte-hex>
# Compose persists local files in storage_data. Back up this volume with PostgreSQL.
# For S3, set STORAGE_PROVIDER=s3 and configure S3_ENDPOINT/REGION/BUCKET/ACCESS_KEY/SECRET_KEY.
EMAIL_PROVIDER=smtp
EMAIL_FROM=EasyJob <access@yourdomain.com>
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
AI_SERVICE_URL=http://ai:8000
AI_API_KEY=<independent-random-32-byte-hex>
AI_PROVIDER=openai
OPENAI_API_KEY=<provider-api-key>
OPENAI_MODEL=<model-available-on-your-provider>
# Optional OpenAI-compatible endpoint; leave empty to use provider default.
OPENAI_BASE_URL=
# Enable only after camera testing and threshold calibration on staging.
BIOMETRIC_ENABLED=false
BIOMETRIC_ENCRYPTION_KEY=<independent-random-32-byte-hex>
FACE_LIVENESS_ENABLED=true
FACE_MATCH_THRESHOLD=0.5
AI_FACE_SERVICE_URL=http://ai:8000
# Choose a real payment adapter; configure its live credentials and webhook.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=<stripe-live-secret>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>
STRIPE_PRICE_MAP_CANDIDATE_PRO_MONTHLY=<price-id>
STRIPE_PRICE_MAP_CANDIDATE_PRO_YEARLY=<price-id>
STRIPE_PRICE_MAP_CANDIDATE_PREMIUM_MONTHLY=<price-id>
STRIPE_PRICE_MAP_CANDIDATE_PREMIUM_YEARLY=<price-id>
STRIPE_PRICE_MAP_COMPANY_BUSINESS_MONTHLY=<price-id>
STRIPE_PRICE_MAP_COMPANY_BUSINESS_YEARLY=<price-id>
STRIPE_PRICE_MAP_COMPANY_PRO_MONTHLY=<price-id>
STRIPE_PRICE_MAP_COMPANY_PRO_YEARLY=<price-id>
STRIPE_PRICE_MAP_COMPANY_ENTERPRISE_MONTHLY=<price-id>
STRIPE_PRICE_MAP_COMPANY_ENTERPRISE_YEARLY=<price-id>
# Alternative PAYMENT_PROVIDER=konnect:
KONNECT_MODE=live
KONNECT_API_KEY=
KONNECT_RECEIVER_WALLET_ID=
KONNECT_WEBHOOK_URL=
KONNECT_WEBHOOK_SECRET=
