{
  "name": "startup-starter-backend",
  "version": "1.0.0",
  "description": "Startup Starter - multi-tenant recruitment SaaS backend (NestJS + Prisma + PostgreSQL + Redis + BullMQ)",
  "author": "Startup Starter",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:api": "powershell -NoProfile -File scripts/start-local-api.ps1",
    "dev:profiles": "powershell -NoProfile -File scripts/start-profile-services.ps1",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker-main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:seed:system": "ts-node prisma/seed-system.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --config jest.config.js --runInBand",
    "test:e2e": "jest --config jest-e2e.json --runInBand",
    "test:cov": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "release:check": "node scripts/release-check.cjs",
    "admin:grant": "node scripts/bootstrap-admin.cjs",
    "demo:offers": "node scripts/add-test-offers.cjs",
    "demo:real-offers": "node scripts/add-real-offers.cjs",
    "pricing:candidates": "node scripts/update-candidate-pricing.cjs",
    "pricing:companies": "node scripts/update-company-pricing.cjs"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/platform-socket.io": "^11.2.3",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.2.3",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "helmet": "^7.2.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^10.0.3",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "slugify": "^1.6.6",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.17.9",
    "@types/nodemailer": "^6.4.15",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "multer": "2.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
